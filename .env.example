SCREEPS_TOKEN=
SCREEPS_HOST=
SCREEPS_BRANCH=
SCREEPS_SHARD=

# Local private testing only. Do not point these values at screeps.com.
SCREEPS_TARGET=private
SCREEPS_PRIVATE_TESTING=false
SCREEPS_PRIVATE_PROTOCOL=http
SCREEPS_PRIVATE_HOST=127.0.0.1
SCREEPS_PRIVATE_PORT=21025
SCREEPS_PRIVATE_CLI_PORT=21026
SCREEPS_PRIVATE_USERNAME=agentic-bot
SCREEPS_PRIVATE_PASSWORD=agentic-local-password
SCREEPS_PRIVATE_BRANCH=private-combat
SCREEPS_PRIVATE_ROOM=W1N1
SCREEPS_PRIVATE_DATA_DIR=.screeps-private
SCREEPS_PRIVATE_PRESERVE_WORLD=false
SCREEPS_PRIVATE_START_TIMEOUT_MS=300000
STEAM_KEY=

# Optional LLM diagnostic analysis. Normal verification and fake analysis do not require these.
DIAGNOSTIC_ANALYSIS_ENABLED=false
DIAGNOSTIC_ANALYSIS_PROVIDER=disabled
DIAGNOSTIC_ANALYSIS_MODEL=gpt-4.1-mini
DIAGNOSTIC_ANALYSIS_API_KEY=
# Optional fallback used when DIAGNOSTIC_ANALYSIS_API_KEY is empty.
OPENAI_API_KEY=
DIAGNOSTIC_ANALYSIS_MAX_INPUT_TOKENS=24000
DIAGNOSTIC_ANALYSIS_MAX_OUTPUT_TOKENS=4000
DIAGNOSTIC_ANALYSIS_TIMEOUT_MS=60000
DIAGNOSTIC_ANALYSIS_RETRY_COUNT=1
