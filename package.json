{
  "name": "agentic-screeps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build-release.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && node scripts/verify-release.mjs dist/release-manifest.json",
    "deploy:candidate": "node scripts/deploy-screeps.mjs",
    "deploy:production": "node scripts/activate-branch.mjs",
    "rollback:production": "node scripts/rollback-screeps.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.13.14",
    "@types/screeps": "^3.3.8",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.8",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
